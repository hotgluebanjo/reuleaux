set cut_paste_input [stack 0]
version 16.0 v6
push $cut_paste_input
Group {
 name ReuleauxAbicio
 selected true
 xpos -9132
 ypos 3788
 addUserKnob {20 User}
 addUserKnob {4 direction M {forward inverse}}
}
 Input {
  inputs 0
  name Input
  xpos -49
  ypos 66
 }
set Nb770cd80 [stack 0]
 Multiply {
  value {{2*pi} 1 1 1}
  name Denormalize
  xpos 48
  ypos 147
 }
 Expression {
  expr1 "g > 1 ? (3 * atan(sqrt(2)) / sqrt(2)) * (g - 1) + 1 : tan(g * atan(sqrt(2))) / sqrt(2)"
  name Spherical_to_Conic
  xpos 48
  ypos 183
 }
 Expression {
  expr0 "g * cos(r)"
  expr1 "g * sin(r)"
  name Polar_to_Cartesian
  xpos 48
  ypos 207
 }
 Expression {
  temp_name0 r_
  temp_expr0 "(2*r + 1) / 3"
  temp_name1 g_
  temp_expr1 "(sqrt(3)*g - r + 1) / 3"
  temp_name2 b_
  temp_expr2 "(-sqrt(3)*g - r + 1) / 3"
  expr0 "r_ * b / max(r_, g_, b_)"
  expr1 "g_ * b / max(r_, g_, b_)"
  expr2 "b_ * b / max(r_, g_, b_)"
  name uvH_to_RGB
  xpos 48
  ypos 231
 }
push $Nb770cd80
 Expression {
  temp_name0 sum
  temp_expr0 "r + g + b"
  temp_name1 r_
  temp_expr1 "sum == 0 ? 0 : r / sum"
  temp_name2 g_
  temp_expr2 "sum == 0 ? 0 : g / sum"
  temp_name3 b_
  temp_expr3 "sum == 0 ? 0 : b / sum"
  expr0 "(2 * r_ - g_ - b_) / 2"
  expr1 "sqrt(3) / 2 * (g_ - b_)"
  expr2 "max(r, g, b)"
  name RGB_to_uvH
  xpos -126
  ypos 145
 }
 Expression {
  expr0 "pi - atan2(g, -r)"
  expr1 "hypot(r, g)"
  name Cartesian_to_Polar
  xpos -126
  ypos 169
 }
 Expression {
  expr1 "g > 1 ? (sqrt(2) / (3 * atan(sqrt(2)))) * (g - 1) + 1 : atan(g * sqrt(2)) / (atan(sqrt(2)))"
  name Conic_to_Spherical
  xpos -126
  ypos 193
 }
 Multiply {
  value {{1/(2*pi)} 1 1 1}
  name Normalize1
  xpos -126
  ypos 217
 }
 Switch {
  inputs 2
  which {{parent.direction}}
  name Inverse
  xpos -40
  ypos 303
 }
 Output {
  name Output1
