// https://github.com/hotgluebanjo

#define N_POINTS 9

DEFINE_UI_PARAMS(g_overall_sat, Overall Saturation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 5.0, 0.001)

DEFINE_UI_PARAMS(g_red_hue, Red Hue, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.001)
DEFINE_UI_PARAMS(g_red_sat, Red Saturation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 5.0, 0.001)

DEFINE_UI_PARAMS(g_yel_hue, Yellow Hue, DCTLUI_SLIDER_FLOAT, 0.166, 0.0, 0.333, 0.001)
DEFINE_UI_PARAMS(g_yel_sat, Yellow Saturation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 5.0, 0.001)

DEFINE_UI_PARAMS(g_grn_hue, Green Hue, DCTLUI_SLIDER_FLOAT, 0.333, 0.166, 0.5, 0.001)
DEFINE_UI_PARAMS(g_grn_sat, Green Saturation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 5.0, 0.001)

DEFINE_UI_PARAMS(g_cyn_hue, Cyan Hue, DCTLUI_SLIDER_FLOAT, 0.5, 0.333, 0.666, 0.001)
DEFINE_UI_PARAMS(g_cyn_sat, Cyan Saturation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 5.0, 0.001)

DEFINE_UI_PARAMS(g_blu_hue, Blue Hue, DCTLUI_SLIDER_FLOAT, 0.666, 0.5, 0.8333, 0.001)
DEFINE_UI_PARAMS(g_blu_sat, Blue Saturation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 5.0, 0.001)

DEFINE_UI_PARAMS(g_mag_hue, Magenta Hue, DCTLUI_SLIDER_FLOAT, 0.833, 0.666, 1.0, 0.001)
DEFINE_UI_PARAMS(g_mag_sat, Magenta Saturation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 5.0, 0.001)

DEFINE_UI_PARAMS(g_isolation, Isolation, DCTLUI_SLIDER_FLOAT, 5.0, 1.0, 10.0, 0.001)

DEFINE_UI_PARAMS(g_sample_precision, Inverse Sample Precision, DCTLUI_SLIDER_INT, 10, 1, 16, 1)
DEFINE_UI_PARAMS(g_invert, Invert, DCTLUI_CHECK_BOX, 0)

__DEVICE__ inline float sn_lift(float x, float l, float s) {
    if (x > 1.0f) {
        return x;
    }
    return x * (1.0f + (l - 1.0f) * _powf(1.0f - x, s));
}

__DEVICE__ inline float hgb_smoothstep(float a, float b, float x) {
    float t = _saturatef((x - a) / (b - a));
    return t * t * (3.0f - 2.0f * t);
}

__DEVICE__ float ls_s(__PRIVATE__ float2 *pts, int n_pts, float x) {
    if (x <= pts[0].x) {
        return pts[0].y;
    }
    if (x >= pts[n_pts - 1].x) {
        return pts[n_pts - 1].y;
    }
    int i = 0;
    int upper = n_pts - 1;
    while (i != upper - 1) {
        int m = i + (upper - i) / 2;
        if (x >= pts[m].x) {
            i = m;
        } else {
            upper = m;
        }
    }
    float t = hgb_smoothstep(pts[i].x, pts[i + 1].x, x);
    return _mix(pts[i].y, pts[i + 1].y, t);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B) {
    float2 curve[N_POINTS];

    if (g_red_hue > 0.5f) {
        curve[1] = make_float2(g_red_hue - 1.0f, g_red_sat);
        curve[7] = make_float2(g_red_hue, g_red_sat);
    } else {
        curve[1] = make_float2(g_red_hue, g_red_sat);
        curve[7] = make_float2(g_red_hue + 1.0f, g_red_sat);
    }

    curve[0] = make_float2(g_mag_hue - 1.0f, g_mag_sat);
    curve[8] = make_float2(g_yel_hue + 1.0f, g_yel_sat);

    curve[2] = make_float2(g_yel_hue, g_yel_sat);
    curve[3] = make_float2(g_grn_hue, g_grn_sat);
    curve[4] = make_float2(g_cyn_hue, g_cyn_sat);
    curve[5] = make_float2(g_blu_hue, g_blu_sat);
    curve[6] = make_float2(g_mag_hue, g_mag_sat);

    float hue = p_R;
    float sat = p_G;

    float factor = (g_overall_sat - 1.0f) + ls_s(curve, N_POINTS, hue);
    float res;
    if (g_invert) {
        int n_samples = 1 << g_sample_precision;
        if (sat <= 0.0f) {
            res = 0.0f;
        } else if (sat >= 1.0f) {
            res = sat; // okay due to slope I believe
        } else {
            int i = 0;
            int upper = n_samples - 1;
            while (i != upper - 1) {
                int m = i + (upper - i) / 2;
                float vm = sn_lift((float)m / (float)(n_samples - 1), factor, g_isolation);
                if (sat >= vm) {
                    i = m;
                } else {
                    upper = m;
                }
            }
            float c0 = (float)i / (float)(n_samples - 1);
            float c1 = (float)(i + 1) / (float)(n_samples - 1);
            float v0 = sn_lift(c0, factor, g_isolation);
            float v1 = sn_lift(c1, factor, g_isolation);
            float t = (sat - v0) / (v1 - v0);
            res = _mix(c0, c1, t);
        }
    } else {
        res = sn_lift(sat, factor, g_isolation);
    }

    return make_float3(p_R, res, p_B);
}
