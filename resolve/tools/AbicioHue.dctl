// https://github.com/hotgluebanjo

#define N_POINTS 9

DEFINE_UI_PARAMS(g_red_x, Red x, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.001)
DEFINE_UI_PARAMS(g_red_y, Red y, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.001)

DEFINE_UI_PARAMS(g_yel_x, Yellow x, DCTLUI_SLIDER_FLOAT, 0.166, 0.0, 0.333, 0.001)
DEFINE_UI_PARAMS(g_yel_y, Yellow y, DCTLUI_SLIDER_FLOAT, 0.166, 0.0, 0.333, 0.001)

DEFINE_UI_PARAMS(g_grn_x, Green x, DCTLUI_SLIDER_FLOAT, 0.333, 0.166, 0.5, 0.001)
DEFINE_UI_PARAMS(g_grn_y, Green y, DCTLUI_SLIDER_FLOAT, 0.333, 0.166, 0.5, 0.001)

DEFINE_UI_PARAMS(g_cyn_x, Cyan x, DCTLUI_SLIDER_FLOAT, 0.5, 0.333, 0.666, 0.001)
DEFINE_UI_PARAMS(g_cyn_y, Cyan y, DCTLUI_SLIDER_FLOAT, 0.5, 0.333, 0.666, 0.001)

DEFINE_UI_PARAMS(g_blu_x, Blue x, DCTLUI_SLIDER_FLOAT, 0.666, 0.5, 0.833, 0.001)
DEFINE_UI_PARAMS(g_blu_y, Blue y, DCTLUI_SLIDER_FLOAT, 0.666, 0.5, 0.833, 0.001)

DEFINE_UI_PARAMS(g_mag_x, Magenta x, DCTLUI_SLIDER_FLOAT, 0.833, 0.666, 1.0, 0.001)
DEFINE_UI_PARAMS(g_mag_y, Magenta y, DCTLUI_SLIDER_FLOAT, 0.833, 0.666, 1.0, 0.001)

DEFINE_UI_PARAMS(g_sample_precision, Inverse Sample Precision, DCTLUI_SLIDER_INT, 10, 1, 16, 1)
DEFINE_UI_PARAMS(g_invert, Invert, DCTLUI_CHECK_BOX, 0)

__DEVICE__ float hr_vm(float2 pts[N_POINTS], float x) {
    if (x <= pts[0].x) {
        return pts[0].y;
    }
    if (x >= pts[N_POINTS - 1].x) {
        return pts[N_POINTS - 1].y;
    }
    int i = 0;
    int u = N_POINTS - 1;
    while (i != u - 1) {
        int m = i + (u - i) / 2;
        if (x >= pts[m].x) {
            i = m;
        } else {
            u = m;
        }
    }
    float m0, m1;
    if (i == 0) {
        m0 = (pts[i + 1].y - pts[i].y) / (pts[i + 1].x - pts[i].x);
        m1 = ((pts[i + 1].y - pts[i].y) / (pts[i + 1].x - pts[i].x)
            + (pts[i + 2].y - pts[i + 1].y) / (pts[i + 2].x - pts[i + 1].x)) / 2.0f;
    } else if (i == N_POINTS - 2) {
        m0 = ((pts[i].y - pts[i - 1].y) / (pts[i].x - pts[i - 1].x)
            + (pts[i + 1].y - pts[i].y) / (pts[i + 1].x - pts[i].x)) / 2.0f;
        m1 = (pts[i].y - pts[i - 1].y) / (pts[i].x - pts[i - 1].x);
    } else {
        m0 = ((pts[i].y - pts[i - 1].y) / (pts[i].x - pts[i - 1].x)
            + (pts[i + 1].y - pts[i].y) / (pts[i + 1].x - pts[i].x)) / 2.0f;
        m1 = ((pts[i + 1].y - pts[i].y) / (pts[i + 1].x - pts[i].x)
            + (pts[i + 2].y - pts[i + 1].y) / (pts[i + 2].x - pts[i + 1].x)) / 2.0f;
    }
    float delta = pts[i + 1].x - pts[i].x;
    float t = (x - pts[i].x) / delta;
    float h00 = 2.0f * _powf(t, 3.0f) - 3.0f * _powf(t, 2.0f) + 1.0f;
    float h10 = _powf(t, 3.0f) - 2.0f * _powf(t, 2.0f) + t;
    float h01 = -2.0f * _powf(t, 3.0) + 3.0f * _powf(t, 2.0f);
    float h11 = _powf(t, 3.0f) - _powf(t, 2.0f);
    return h00 * pts[i].y + h10 * m0 * delta + h01 * pts[i + 1].y + h11 * m1 * delta;
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B) {
    float2 curve[N_POINTS];
    float2 red_user = make_float2(g_red_x, g_red_y);

    if (g_red_x < 0.5f && g_red_y < 0.5f) {
        curve[1] = red_user;
        curve[7] = red_user + 1.0f;
    } else if (g_red_x < 0.5f && g_red_y >= 0.5f) {
        curve[1] = make_float2(g_red_x, g_red_y - 1.0f);
        curve[7] = make_float2(g_red_x + 1.0f, g_red_y);
    } else if (g_red_x >= 0.5f && g_red_y < 0.5f) {
        curve[1] = make_float2(g_red_x - 1.0f, g_red_y);
        curve[7] = make_float2(g_red_x, g_red_y + 1.0f);
    } else {
        curve[1] = red_user - 1.0f;
        curve[7] = red_user;
    }

    curve[2] = make_float2(g_yel_x, g_yel_y);
    curve[3] = make_float2(g_grn_x, g_grn_y);
    curve[4] = make_float2(g_cyn_x, g_cyn_y);
    curve[5] = make_float2(g_blu_x, g_blu_y);
    curve[6] = make_float2(g_mag_x, g_mag_y);

    curve[0] = curve[6] - 1.0f;
    curve[8] = curve[2] + 1.0f;

    float hue = p_R;
    float res;
    if (g_invert) {
        int n_samples = 1 << g_sample_precision;
        float d_s = -0.5f;
        float d_e =  1.5f;
        float dt_n = (d_e - d_s) / (float)(n_samples - 1);
        int i = 0;
        int u = n_samples - 1;
        while (i != u - 1) {
            int m = i + (u - i) / 2;
            float vm = hr_vm(curve, d_s + (float)m * dt_n);
            if (hue >= vm) {
                i = m;
            } else {
                u = m;
            }
        }
        float c0 = d_s + (float)i * dt_n;
        float c1 = d_s + (float)(i + 1) * dt_n;
        float v0 = hr_vm(curve, c0);
        float v1 = hr_vm(curve, c1);
        float t = (hue - v0) / (v1 - v0);
        res = _mix(c0, c1, t);
    } else {
        res = hr_vm(curve, hue);
    }

    return make_float3(res, p_G, p_B);
}
